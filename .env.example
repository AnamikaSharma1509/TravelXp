# TRAVELXP ENVIRONMENT CONFIGURATION

# Backend Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres@localhost:5434/travelxp"
JWT_SECRET="replace-with-a-secure-random-secret-key"
SESSION_SECRET="replace-with-a-secure-session-key"
FRONTEND_URL="http://localhost:5173"
API_BASE_URL="http://localhost:5000/api/v1"

# Client Configuration (Vite)
VITE_API_URL="http://localhost:5000/api/v1"
# Client-side Google Maps JavaScript API Key (browser-restricted)
# Enable: Maps JavaScript API, Places API (for search/autocomplete)
# Fallback: Leaflet + Carto Voyager tile layer is automatically active if key is not provided
VITE_GOOGLE_MAPS_API_KEY=""

# Third-party Integrations (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OPENAI_API_KEY=""
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="noreply@travelxp.local"

# Server-Side Geocoding / Routing (keep separate from client key)
GOOGLE_MAPS_SERVER_API_KEY=""

